# InsightX Environment Configuration Template
DEBUG=True

# Universal LLM Configuration
# Protocol: "openai" (OpenAI / DeepSeek / Qwen / Kimi / Ollama) or "anthropic" (Claude)
LLM_PROTOCOL=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini

# Optional Services
YOUTUBE_API_KEY=your_google_youtube_api_key_here
